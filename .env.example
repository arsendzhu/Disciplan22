# Web app public config
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CANVAS_REDIRECT_URI=http://localhost:3000/connect-canvas

# Web app server-only keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=

# Canvas (server-side — never expose to the browser)
# Instance URL for API + OAuth (no trailing slash)
CANVAS_BASE_URL=https://csueastbay.instructure.com
# Browser session copied from DevTools — used by Next.js API routes (optional if using OAuth only)
CANVAS_COOKIE=
CANVAS_CSRF=

ELEVENLABS_API_KEY=
