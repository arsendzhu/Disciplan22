# Canvas host (no /api/v1 — that is added in code). CSUEB often uses instructure.com.
CANVAS_BASE_URL=https://csueb.instructure.com

# Session values from DevTools (Network request headers or Application → Cookies).
# Never commit a filled .env file.
CANVAS_COOKIE=
CANVAS_CSRF=

ELEVENLABS_API_KEY=
